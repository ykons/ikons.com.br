---
import { faqItems } from '../data/faq';
import { siteConfig } from '../data/config';
---

<section id="faq" class="py-20 sm:py-28 relative transition-colors duration-300">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-cyan-400 border border-blue-200 dark:border-blue-500/20 mb-3">
        Dúvidas Frequentes
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Perguntas & Respostas
      </h2>
      <p class="mt-4 text-base text-slate-600 dark:text-slate-300">
        Tudo o que você precisa saber sobre nossos serviços de registro de domínio e hospedagem de sites.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {faqItems.map((item, index) => (
        <div class="rounded-3xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm dark:shadow-none transition-all duration-200">
          <button 
            type="button" 
            class="faq-btn w-full px-6 py-5 text-left flex items-center justify-between gap-4 text-slate-900 dark:text-white hover:text-blue-600 dark:hover:text-cyan-400 transition-colors cursor-pointer"
            data-target={`faq-content-${index}`}
            aria-expanded="false"
          >
            <span class="text-base sm:text-lg font-semibold">{item.question}</span>
            <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center shrink-0 text-slate-500 dark:text-slate-400 transition-transform duration-200 faq-icon">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </button>
          <div 
            id={`faq-content-${index}`} 
            class="faq-content hidden px-6 pb-6 text-sm text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-slate-800/40 pt-4"
          >
            {item.answer}
          </div>
        </div>
      ))}
    </div>

    <!-- Still Have Questions CTA -->
    <div class="mt-14 p-8 rounded-3xl bg-gradient-to-r from-blue-50 via-slate-50 to-cyan-50 dark:from-blue-950/40 dark:via-slate-900 dark:to-cyan-950/30 border border-slate-200 dark:border-slate-800 text-center shadow-md dark:shadow-none">
      <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">Ainda tem alguma dúvida técnica ou comercial?</h3>
      <p class="text-sm text-slate-600 dark:text-slate-400 max-w-xl mx-auto mb-6">
        Nossa equipe de suporte está pronta para te atender através da nossa plataforma em <strong class="text-slate-900 dark:text-white">suporte.ikons.com.br</strong> ou por e-mail.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a 
          href={siteConfig.links.support} 
          target="_blank" 
          rel="noopener noreferrer"
          class="px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white text-sm font-semibold rounded-2xl shadow-lg shadow-blue-500/20 transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Abrir Chamado de Suporte</span>
        </a>
        <a 
          href={`mailto:${siteConfig.links.contactEmail}`}
          class="px-6 py-3 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-800 dark:text-white text-sm font-semibold rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>{siteConfig.links.contactEmail}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const faqButtons = document.querySelectorAll('.faq-btn');

  faqButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');
      if (!targetId) return;

      const content = document.getElementById(targetId);
      const icon = btn.querySelector('.faq-icon');
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';

      if (content && icon) {
        if (isExpanded) {
          content.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          icon.classList.remove('rotate-180');
        } else {
          content.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          icon.classList.add('rotate-180');
        }
      }
    });
  });
</script>
