---
import DomainSearch from './DomainSearch.astro';
---

<section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto">
      
      <!-- Top Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-cyan-400 border border-blue-200 dark:border-blue-500/20 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Infraestrutura de Alta Confiabilidade
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.15]">
        A hospedagem <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-600 to-indigo-600 dark:from-blue-400 dark:via-cyan-400 dark:to-indigo-400">rápida e segura</span> que o seu negócio precisa
      </h1>

      <!-- Subheadline -->
      <p class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Soluções profissionais de <strong>hospedagem de sites</strong> e <strong>registro de domínio</strong> com painel cPanel, contas de e-mail corporativo, armazenamento SSD de alta velocidade e suporte especializado.
      </p>

      <!-- Trust Badges -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-blue-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Painel cPanel Oficial</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-blue-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Armazenamento SSD NVMe</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-blue-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Certificado SSL Grátis</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-blue-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Suporte Especializado</span>
        </div>
      </div>
    </div>

    <!-- Domain Search Component -->
    <DomainSearch />
  </div>
</section>
