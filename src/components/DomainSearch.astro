---
import { domainExtensions } from '../data/pricing';
---

<div id="dominios" class="scroll-mt-28 sm:scroll-mt-32 w-full max-w-4xl mx-auto mt-10 transition-colors duration-300">
  <div class="relative bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-700/70 rounded-3xl p-6 sm:p-8 shadow-md dark:shadow-none backdrop-blur-xl">
    <!-- Glow effect -->
    <div class="absolute -inset-0.5 bg-gradient-to-r from-blue-600 to-cyan-500 rounded-3xl blur opacity-10 dark:opacity-20 -z-10"></div>

    <div class="text-center mb-6">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-cyan-50 dark:bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-500/20 mb-3">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
        Registro de Domínio
      </span>
      <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight">
        Encontre o endereço ideal para o seu projeto na internet
      </h3>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
        Consulte a disponibilidade em tempo real de domínios nacionais (.br) e internacionais com DNS gerenciado e suporte técnico.
      </p>
    </div>

    <!-- Search Form -->
    <form id="domain-search-form" class="space-y-4">
      <div class="flex flex-col sm:flex-row gap-2">
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            type="text" 
            id="domain-input" 
            placeholder="Digite seu domínio (ex: suaempresa.com.br)"
            required
            autocomplete="off"
            spellcheck="false"
            class="w-full pl-11 pr-4 py-3.5 bg-slate-50 dark:bg-slate-950/80 border border-slate-300 dark:border-slate-700 rounded-2xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-cyan-500 text-base transition-all"
          />
        </div>
        <button 
          type="submit" 
          id="domain-submit-btn"
          class="px-7 py-3.5 bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-semibold rounded-2xl transition-all duration-200 shadow-lg shadow-blue-600/20 flex items-center justify-center gap-2 text-base cursor-pointer hover:shadow-cyan-500/25"
        >
          <span>Consultar</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </div>
    </form>

    <!-- Quick Extension Pills -->
    <div class="mt-6 pt-5 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      {domainExtensions.map(ext => (
        <button 
          type="button" 
          class="domain-extension-btn inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800/60 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700/50 hover:border-blue-400 dark:hover:border-cyan-500/50 text-xs text-slate-700 dark:text-slate-300 transition-all cursor-pointer"
          data-tld={ext.tld}
        >
          <span class="font-bold text-slate-900 dark:text-white">{ext.tld}</span>
          <span class="text-blue-600 dark:text-cyan-400 font-medium">{ext.price}</span>
        </button>
      ))}
    </div>

    <!-- Results Box (Dynamically Rendered by JS) -->
    <div id="domain-result-container" class="mt-6 hidden transition-all duration-300">
      <div id="domain-result-card" class="p-4 sm:p-5 rounded-2xl border flex flex-col sm:flex-row items-center justify-between gap-4">
        <!-- Result Content Injected Here -->
      </div>
    </div>
  </div>
</div>

<script>
  import { checkDomainAvailability } from '../utils/api';
  import { domainExtensions } from '../data/pricing';

  const form = document.getElementById('domain-search-form') as HTMLFormElement | null;
  const input = document.getElementById('domain-input') as HTMLInputElement | null;
  const resultContainer = document.getElementById('domain-result-container');
  const resultCard = document.getElementById('domain-result-card');
  const submitBtn = document.getElementById('domain-submit-btn');
  const extensionButtons = document.querySelectorAll('.domain-extension-btn');

  extensionButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const tld = btn.getAttribute('data-tld') || '.com.br';
      if (input) {
        let current = input.value.trim().toLowerCase();
        current = current.replace(/\.(com\.br|com|net|org\.br|info|online)$/, '');
        if (current) {
          input.value = current + tld;
        } else {
          input.value = 'minhaempresa' + tld;
        }
        input.focus();
      }
    });
  });

  function getDomainPrice(domain: string): string {
    // Sempre utiliza o valor tabelado no site (pricing.ts), priorizando extensões mais específicas
    const match = [...domainExtensions]
      .sort((a, b) => b.tld.length - a.tld.length)
      .find(ext => domain.endsWith(ext.tld));
    return match ? match.price : 'R$ 60,00/ano';
  }

  if (form && input && resultContainer && resultCard && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      let rawDomain = input.value.trim().toLowerCase();
      if (!rawDomain) return;

      // Normaliza domínio caso o usuário não tenha digitado a extensão
      if (!rawDomain.includes('.')) {
        rawDomain = rawDomain + '.com.br';
        input.value = rawDomain;
      }

      submitBtn.setAttribute('disabled', 'true');
      const originalBtnText = submitBtn.innerHTML;
      submitBtn.innerHTML = `
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Consultando...</span>
      `;

      try {
        const result = await checkDomainAvailability(rawDomain);
        const domain = result.domain || rawDomain;
        const priceLabel = getDomainPrice(domain);

        if (result.available) {
          // Domínio Disponível para Registro
          resultCard.className = "p-5 rounded-2xl border border-emerald-500/40 bg-emerald-50/80 dark:bg-emerald-950/20 flex flex-col sm:flex-row items-center justify-between gap-4";
          resultCard.innerHTML = `
            <div class="flex items-center gap-3 text-left">
              <div class="w-10 h-10 rounded-full bg-emerald-500/15 dark:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <div class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  Domínio Disponível para Registro
                </div>
                <div class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">${domain}</div>
                <div class="text-xs text-slate-600 dark:text-slate-400">DNS gerenciado e ativação inclusa por apenas <strong class="text-slate-900 dark:text-white">${priceLabel}</strong></div>
              </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <button 
                type="button" 
                id="btn-register-domain"
                class="w-full sm:w-auto px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold rounded-xl shadow-md transition-all cursor-pointer"
              >
                Registrar com Hospedagem
              </button>
            </div>
          `;

          const registerBtn = document.getElementById('btn-register-domain');
          if (registerBtn) {
            registerBtn.addEventListener('click', () => {
              if (typeof (window as any).openOrderModal === 'function') {
                (window as any).openOrderModal(domain, 'intermediario', 'Intermediário');
              }
            });
          }
        } else {
          // Domínio Já Registrado
          resultCard.className = "p-5 rounded-2xl border border-amber-500/40 bg-amber-50/70 dark:bg-amber-950/20 flex flex-col sm:flex-row items-center justify-between gap-4";
          resultCard.innerHTML = `
            <div class="flex items-center gap-3 text-left">
              <div class="w-10 h-10 rounded-full bg-amber-500/15 dark:bg-amber-500/20 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
              <div>
                <div class="text-xs font-bold text-amber-700 dark:text-amber-400 uppercase tracking-wider">Domínio Já Registrado</div>
                <div class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">${domain}</div>
                <div class="text-xs text-slate-600 dark:text-slate-400 max-w-md">Já é o proprietário deste endereço? Você pode vinculá-lo aos nossos planos de hospedagem com cPanel e e-mails profissionais.</div>
              </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <button 
                type="button" 
                id="btn-use-domain"
                class="w-full sm:w-auto px-5 py-2.5 bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 text-white text-sm font-semibold rounded-xl shadow-md transition-all cursor-pointer whitespace-nowrap"
              >
                Hospedar este Domínio
              </button>
            </div>
          `;

          const useDomainBtn = document.getElementById('btn-use-domain');
          if (useDomainBtn) {
            useDomainBtn.addEventListener('click', () => {
              if (typeof (window as any).openOrderModal === 'function') {
                (window as any).openOrderModal(domain, 'intermediario', 'Intermediário');
              }
            });
          }
        }
        resultContainer.classList.remove('hidden');
      } catch (err: any) {
        // Erro na requisição ou domínio inválido
        resultCard.className = "p-5 rounded-2xl border border-rose-500/40 bg-rose-50/70 dark:bg-rose-950/20 flex flex-col sm:flex-row items-center justify-between gap-4";
        resultCard.innerHTML = `
          <div class="flex items-center gap-3 text-left">
            <div class="w-10 h-10 rounded-full bg-rose-500/15 dark:bg-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <div class="text-xs font-bold text-rose-700 dark:text-rose-400 uppercase tracking-wider">Aviso de Consulta</div>
              <div class="text-sm font-semibold text-slate-900 dark:text-white">${err.message || 'Não foi possível consultar este domínio no momento.'}</div>
              <div class="text-xs text-slate-500 dark:text-slate-400">Verifique a ortografia do domínio ou continue com a contratação de sua hospedagem.</div>
            </div>
          </div>
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <button 
              type="button" 
              id="btn-error-continue"
              class="w-full sm:w-auto px-5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold rounded-xl shadow-md transition-all cursor-pointer whitespace-nowrap"
            >
              Contratar Hospedagem
            </button>
          </div>
        `;

        const errorContinueBtn = document.getElementById('btn-error-continue');
        if (errorContinueBtn) {
          errorContinueBtn.addEventListener('click', () => {
            if (typeof (window as any).openOrderModal === 'function') {
              (window as any).openOrderModal(rawDomain, 'intermediario', 'Intermediário');
            }
          });
        }
        resultContainer.classList.remove('hidden');
      } finally {
        submitBtn.removeAttribute('disabled');
        submitBtn.innerHTML = originalBtnText;
      }
    });
  }
</script>
