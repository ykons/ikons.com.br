---
import { siteConfig } from '../data/config';
---

<section id="central-cliente" class="py-20 sm:py-28 relative border-t border-slate-200 dark:border-slate-800/80 bg-slate-100/60 dark:bg-slate-950/60 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-cyan-400 border border-blue-200 dark:border-blue-500/20 mb-3">
        Área do Cliente
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Central de Acesso Rápido
      </h2>
      <p class="mt-4 text-base text-slate-600 dark:text-slate-300">
        Acesse seus serviços com apenas um clique: webmail corporativo, painel de administração e abertura de tickets de suporte.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Webmail Card -->
      <a 
        href={siteConfig.links.webmail}
        target="_blank" 
        rel="noopener noreferrer"
        class="p-6 rounded-3xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 hover:border-blue-500 dark:hover:border-cyan-500/50 shadow-md shadow-slate-200/50 dark:shadow-none hover:shadow-lg transition-all duration-200 group flex flex-col justify-between"
      >
        <div>
          <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-cyan-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Acessar Webmail</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Consulte suas mensagens, envie e-mails e gerencie suas pastas diretamente pelo navegador.
          </p>
        </div>
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-cyan-400 group-hover:translate-x-1 transition-transform">
          <span>Abrir Webmail</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>

      <!-- cPanel Card -->
      <a 
        href={siteConfig.links.cpanel}
        target="_blank" 
        rel="noopener noreferrer"
        class="p-6 rounded-3xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 hover:border-blue-500 dark:hover:border-cyan-500/50 shadow-md shadow-slate-200/50 dark:shadow-none hover:shadow-lg transition-all duration-200 group flex flex-col justify-between"
      >
        <div>
          <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-cyan-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Painel cPanel</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Gerencie bancos de dados MySQL, contas FTP, arquivos do site e certificados de segurança.
          </p>
        </div>
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-cyan-400 group-hover:translate-x-1 transition-transform">
          <span>Acessar Painel</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>

      <!-- Suporte Card -->
      <a 
        href={siteConfig.links.support}
        target="_blank" 
        rel="noopener noreferrer"
        class="p-6 rounded-3xl bg-gradient-to-b from-blue-50 to-white dark:from-blue-950/40 dark:to-slate-900/90 border border-blue-300 dark:border-blue-500/40 hover:border-blue-500 dark:hover:border-cyan-400 shadow-md shadow-blue-500/10 hover:shadow-xl transition-all duration-200 group flex flex-col justify-between"
      >
        <div>
          <div class="w-12 h-12 rounded-2xl bg-blue-600/10 dark:bg-blue-600/20 text-blue-600 dark:text-cyan-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Central de Chamados</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Abra e acompanhe tickets de suporte técnico em nossa plataforma oficial <strong class="text-blue-600 dark:text-cyan-400">suporte.ikons.com.br</strong>.
          </p>
        </div>
        <div class="mt-6 flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-cyan-400 group-hover:translate-x-1 transition-transform">
          <span>Abrir Chamado de Suporte</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </div>
      </a>

      <!-- 2ª Via de Fatura Card -->
      <div 
        class="p-6 rounded-3xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 hover:border-blue-500 dark:hover:border-cyan-500/50 shadow-md shadow-slate-200/50 dark:shadow-none hover:shadow-lg transition-all duration-200 group flex flex-col justify-between"
      >
        <div>
          <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-cyan-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">2ª Via de Cobrança</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Precisa da 2ª via de sua fatura ou código PIX? Nossas faturas são enviadas diretamente ao seu e-mail cadastrado.
          </p>
        </div>
        <div class="mt-6">
          <a 
            href={`mailto:${siteConfig.links.contactEmail}?subject=Solicitacao%20de%20Segunda%20Via%20de%20Fatura`}
            class="inline-flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-cyan-400 group-hover:translate-x-1 transition-transform"
          >
            <span>Solicitar ao Financeiro</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
